# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# URL of your Ollama instance (Linux tower or localhost)
OLLAMA_URL=http://YOUR_LINUX_IP:11434/api/chat

# Model for voice generation (fine-tuned model name in Ollama)
OLLAMA_MODEL=gemma4:31b

# Model for intent classification (fast, structured-output)
CLASSIFIER_MODEL=gemma4:31b

# Your own phone number — used only in startup log messages
BOT_MY_PHONE=+1XXXXXXXXXX

# Your location coordinates for weather lookups
BOT_LATITUDE=YOUR_LATITUDE
BOT_LONGITUDE=YOUR_LONGITUDE

# Comma-separated list of calendar names the bot can create events in
BOT_CALENDARS=Personal,Work,Family,Other

# Comma-separated list of Notes lists the bot can append to
BOT_NOTES=Grocery List,To Do List,Watch List,Home List

# Your timezone for weather lookups (URL-encoded, e.g. America%2FNew_York)
BOT_TIMEZONE=YOUR_TIMEZONE
